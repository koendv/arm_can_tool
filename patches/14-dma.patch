+
+    if (wait_tx)
+        result = rt_completion_wait(&instance->config->dma_tx->cpt, timeout);
+    /* dma_done guards against a stray completion signal that isn't this channel's */
+    if (result == RT_EOK && wait_tx && !instance->config->dma_tx->dma_done)
+        result = -RT_ETIMEOUT;
+
+    if (result == RT_EOK && wait_rx)
+        result = rt_completion_wait(&instance->config->dma_rx->cpt, timeout);
+    if (result == RT_EOK && wait_rx && !instance->config->dma_rx->dma_done)
+        result = -RT_ETIMEOUT;
+
+    if (result != RT_EOK)
+    {
+        LOG_E("%s dma transfer timeout\n", instance->config->spi_name);
+
+        if (wait_tx && !instance->config->dma_tx->dma_done)
