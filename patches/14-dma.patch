+/* wait for dma completion using rt_completion */
+static rt_err_t _spi_dma_wait(struct at32_spi *instance, rt_bool_t wait_tx, rt_bool_t wait_rx, rt_int32_t timeout)
+{
+    rt_err_t result = RT_EOK;
