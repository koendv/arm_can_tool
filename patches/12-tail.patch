+#define TAIL_BLKSIZE_MAX 512
+
+/* print file from current position to EOF */
+static void tail_dump(int fd, rt_uint32_t blk_size)
+{
+    rt_uint8_t buf[TAIL_BLKSIZE_MAX];
+    rt_device_t console;
+    int len;
+
+    console = rt_console_get_device();
+
+    while ((len = read(fd, buf, blk_size)) > 0)
+    {
+        rt_device_write(console, 0, buf, (rt_size_t)len);
+    }
+}
+
+/* find n-th line from the end */
+static rt_uint32_t tail_offset_last_n_lines(int fd, rt_uint32_t size, rt_uint32_t blk_size, rt_uint32_t num_lines)
+{
+    rt_uint8_t buf[TAIL_BLKSIZE_MAX];
+    rt_uint32_t pos;
+    rt_uint32_t count = 0;
+    rt_uint32_t effective_size = size;
+    char last_char;
+
+    if (num_lines == 0 || size == 0)
+    {
+        return size;
+    }
+
+    lseek(fd, (int)(size - 1), SEEK_SET);
+    if (read(fd, &last_char, 1) == 1 && last_char == '\n')
+    {
+        effective_size = size - 1;
+    }
+
+    pos = effective_size;
+    while (pos > 0)
+    {
+        rt_uint32_t chunk = (pos >= blk_size) ? blk_size : pos;
+        int i;
+
+        pos -= chunk;
+        lseek(fd, (int)pos, SEEK_SET);
+        read(fd, buf, chunk);
+
+        for (i = (int)chunk - 1; i >= 0; i--)
+        {
+            if (buf[i] == '\n')
+            {
+                count++;
+                if (count == num_lines)
+                {
+                    return pos + (rt_uint32_t)i + 1;
+                }
+            }
+        }
+    }
+
+    /* fewer than num_lines lines in the whole file */
+    return 0;
+}
+
+/* find n-th line from the beginning */
+static rt_uint32_t tail_offset_from_line(int fd, rt_uint32_t size, rt_uint32_t blk_size, rt_uint32_t start_line)
+{
+    rt_uint8_t buf[TAIL_BLKSIZE_MAX];
+    rt_uint32_t pos = 0;
+    rt_uint32_t count = 0;
+    rt_uint32_t target;
+
+    if (start_line <= 1)
+    {
+        return 0;
+    }
+    target = start_line - 1; /* newlines to skip before the target line starts */
+
+    while (pos < size)
+    {
+        rt_uint32_t remaining = size - pos;
+        rt_uint32_t chunk = (remaining >= blk_size) ? blk_size : remaining;
+        rt_uint32_t i;
+
+        lseek(fd, (int)pos, SEEK_SET);
+        read(fd, buf, chunk);
+
+        for (i = 0; i < chunk; i++)
+        {
+            if (buf[i] == '\n')
+            {
+                count++;
+                if (count == target)
+                {
+                    return pos + i + 1;
+                }
+            }
+        }
+        pos += chunk;
+    }
+
+    return size; /* file has fewer than start_line lines */
+}
+
+/* parse string as number, return false if error */
+static rt_bool_t tail_parse_num(const char *s, rt_uint32_t *out)
+{
+    char *endptr;
+    long value;
+
+    if (s == RT_NULL || *s == '\0')
+    {
+        return RT_FALSE;
+    }
+
+    value = strtol(s, &endptr, 10);
+
+    if (endptr == s || *endptr != '\0' || value < 0 || value == LONG_MAX)
+    {
+        return RT_FALSE;
+    }
+
+    *out = (rt_uint32_t)value;
+    return RT_TRUE;
+}
