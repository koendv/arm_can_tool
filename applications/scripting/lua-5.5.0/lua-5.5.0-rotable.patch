diff -urN ORIG/lua-5.5.0/src/lbaselib.c lua-5.5.0/src/lbaselib.c
--- ORIG/lua-5.5.0/src/lbaselib.c	2025-12-13 20:16:59.000000000 +0100
+++ lua-5.5.0/src/lbaselib.c	2026-04-08 17:35:50.724005793 +0200
@@ -557,3 +557,67 @@
   return 1;
 }
 
+
+/*
+** _VERSION as a function (rotable cannot hold string constants)
+*/
+static int luaB_version(lua_State *L)
+{
+  lua_pushliteral(L, LUA_VERSION);
+  return 1;
+}
+
+int lua_print (lua_State *L) {
+  return luaB_print(L);
+}
+
+/*
+** Base library as rotable.
+** _G self-reference is not registered; scripts cannot iterate globals
+** via _G but can still read/write globals normally via __index/__newindex.
+** _VERSION is exposed as a zero-argument function: _VERSION() -> string.
+*/
+static const rotable_Reg base_lib[] = {
+  { "assert",         luaB_assert,         0 },
+  { "collectgarbage", luaB_collectgarbage, 0 },
+  { "dofile",         luaB_dofile,         0 },
+  { "error",          luaB_error,          0 },
+  { "getmetatable",   luaB_getmetatable,   0 },
+  { "ipairs",         luaB_ipairs,         0 },
+  { "load",           luaB_load,           0 },
+  { "loadfile",       luaB_loadfile,       0 },
+  { "next",           luaB_next,           0 },
+  { "pairs",          luaB_pairs,          0 },
+  { "pcall",          luaB_pcall,          0 },
+  { "print",          luaB_print,          0 },
+  { "warn",           luaB_warn,           0 },
+  { "rawequal",       luaB_rawequal,       0 },
+  { "rawget",         luaB_rawget,         0 },
+  { "rawlen",         luaB_rawlen,         0 },
+  { "rawset",         luaB_rawset,         0 },
+  { "select",         luaB_select,         0 },
+  { "setmetatable",   luaB_setmetatable,   0 },
+  { "tonumber",       luaB_tonumber,       0 },
+  { "tostring",       luaB_tostring,       0 },
+  { "type",           luaB_type,           0 },
+  { "xpcall",         luaB_xpcall,         0 },
+  { "_VERSION",       luaB_version,        0 },
+  { NULL, NULL, 0 }
+};
+
+LUAMOD_API int luaopen_base_rotable(lua_State *L)
+{
+  /* register rotable as _BASE in _G */
+  rotable_newlib(L, base_lib);
+  lua_setglobal(L, "_BASE");
+
+  /* set _G metatable so global lookups fall through to _BASE */
+  lua_pushglobaltable(L);              /* _G */
+  lua_newtable(L);                     /* metatable */
+  lua_getglobal(L, "_BASE");           /* _BASE rotable */
+  lua_setfield(L, -2, "__index");      /* mt.__index = _BASE */
+  lua_setmetatable(L, -2);             /* setmetatable(_G, mt) */
+  lua_pop(L, 1);                       /* pop _G */
+
+  return 0;
+}
