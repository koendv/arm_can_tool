// For format details, see https://aka.ms/devcontainer.json.
// Builds the "tools" stage of tools/docker/Dockerfile:
// toolchain and RT-Thread env/pkgs only, no source cloned or built here.
// The workspace folder you have open is mounted in live instead.
{
	"name": "arm_can_tool",
	"build": {
		"dockerfile": "../tools/docker/Dockerfile",
		"context": "..",
		"target": "tools"
	},
	"settings": {
		"terminal.integrated.defaultProfile.linux": "bash"
	},
	"extensions": [
		"ms-vscode.cpptools"
	]
}
